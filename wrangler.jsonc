{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fce-escalquens",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-31",
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": [
			"/api/*",
			"/admin-api/*",
			"/admin",
			"/admin/*",
			"/internal/*",
			"/media/*",
			"/boutique/suivi",
			"/boutique/suivi/*",
			"/admin-boutique",
			"/admin-boutique/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fce-escalquens",
			"database_id": "883401b1-f229-4c0e-9e25-6493f8d01b93"
		},
		{
			"binding": "ORDERS",
			"database_name": "fce-escalquens-orders",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations-orders"
		},
		{
			"binding": "fce_escalquens_orders_staging",
			"database_name": "fce-escalquens-orders-staging",
			"database_id": "3149647e-9a2f-403a-9591-b7d161bbc98a"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "fce-escalquens-media"
		}
	],
	"env": {
		"staging": {
			"name": "fce-escalquens-staging",
			"workers_dev": true,
			"vars": {
				"APP_ENV": "staging",
				"GITHUB_REPOSITORY": "anaelDelorme/fce-escalquens-site",
				"STAGING_WORKFLOW_REF": "staging"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "fce-escalquens-staging",
					"database_id": "d88cd581-304a-4de5-92ec-d7cb5738ded8"
				},
				{
					"binding": "ORDERS",
					"database_name": "fce-escalquens-orders-staging",
					"database_id": "00000000-0000-0000-0000-000000000000",
					"migrations_dir": "migrations-orders"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "fce-escalquens-media-staging"
				}
			],
			"triggers": {
				"crons": [
					"*/5 * * * *"
				]
			}
		},
		"local": {
			"name": "fce-escalquens-local",
			"vars": {
				"APP_ENV": "local",
				"SHOP_ORIGIN": "http://localhost:8787"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "fce-escalquens-local",
					"database_id": "11111111-1111-4111-8111-111111111111"
				},
				{
					"binding": "ORDERS",
					"database_name": "fce-orders-local",
					"database_id": "22222222-2222-4222-8222-222222222222",
					"migrations_dir": "migrations-orders"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "fce-media-local"
				}
			]
		}
	},
	"vars": {
		"APP_ENV": "production"
	},
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	}
}
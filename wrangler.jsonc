{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fce-escalquens",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-31",
	"workers_dev": false,
	"preview_urls": false,

	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": [
			"/api/*",
			"/admin-api/*",
			"/admin",
			"/admin/*",
			"/internal/*",
			"/media/*"
		]
		},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fce-escalquens",
			"database_id": "883401b1-f229-4c0e-9e25-6493f8d01b93"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "fce-escalquens-media"
		}
	],
	"env": {
		"staging": {
			"name": "fce-escalquens-staging",
			"workers_dev": true,
			"vars": {
				"APP_ENV": "staging",
				"GITHUB_REPOSITORY": "anaelDelorme/fce-escalquens-site",
				"STAGING_WORKFLOW_REF": "develop"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "fce-escalquens-staging",
					"database_id": "d88cd581-304a-4de5-92ec-d7cb5738ded8"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "fce-escalquens-media-staging"
				}
			]
		}
	}
}
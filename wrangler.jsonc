{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fce-escalquens",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-31",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/admin-api/*",
			"/admin",
			"/admin/*",
			"/media/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fce-escalquens",
			"database_id": "883401b1-f229-4c0e-9e25-6493f8d01b93"
		}
		],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "fce-escalquens-media"
		}
	]
}

{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"fce-escalquens",
  "main":"src/worker.ts",
  "compatibility_date":"2026-08-31",
  "assets":{"directory":"./dist","binding":"ASSETS","run_worker_first":["/api/*","/admin-api/*","/media/*"]},
  "d1_databases":[{"binding":"DB","database_name":"fce-escalquens","database_id":"00000000-0000-0000-0000-000000000000"}],
  "r2_buckets":[{"binding":"MEDIA","bucket_name":"fce-escalquens-media"}],
  "vars":{"FFF_API_BASE":"https://api-dofa.fff.fr/api","FFF_CLUB_NO":"101544","FFF_CLUB_CODE":"550350","DISTRICT_FAL_URL":"https://haute-garonne.fff.fr/football-animation-et-loisirs/"}
}

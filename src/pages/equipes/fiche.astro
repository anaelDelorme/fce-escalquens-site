---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<html lang="fr">
  <head>
    <meta charset="utf-8"><meta name="viewport" content="width=device-width">
    <title>Fiche équipe - FC Escalquens</title>
    <link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/enhancements.css?v=6"><link rel="stylesheet" href="/brand-charter.css"><link rel="stylesheet" href="/match-cards.css?v=8">
    <style is:global>
      .profile-layout .staff{display:block}
      .staff-compact{background:#fff;border:1px solid var(--line);border-left:6px solid var(--gold);box-shadow:0 10px 28px #39111b0b}
      .staff-referents{padding:18px 22px 10px;background:#faf5f1}
      .staff-role-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:10px}
      .staff-role-heading>div{display:grid;gap:4px}
      .staff-role-heading span,.staff-row>h3{margin:0;color:var(--wine);font-size:10px;font-weight:950;letter-spacing:.12em;text-transform:uppercase}
      .staff-role-heading small{color:#766a67;font-size:10px;font-weight:700}
      .staff-referent-list{display:flex;flex-wrap:wrap;gap:10px 16px}
      .staff-referent-list.is-single{max-width:430px}
      .staff-referent{min-width:0;display:flex;align-items:center;gap:12px;flex:0 1 420px;padding:14px 16px;background:#fff;border:1px solid #e6dad2;border-radius:18px}
      .staff-referent-photo{width:54px;height:54px;flex:0 0 54px;border-radius:50%;object-fit:cover;border:3px solid #fff;box-shadow:0 0 0 2px var(--gold)}
      .staff-referent-copy{min-width:0;display:grid;gap:6px}
      .staff-referent h3{margin:0;font-family:Arial,sans-serif;font-size:17px;line-height:1.15;text-transform:none}
      .staff-contacts{display:flex;flex-wrap:wrap;gap:5px 14px}
      .staff-contacts a{color:var(--wine);font-size:10px;font-weight:800;text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}
      .staff-row{display:grid;grid-template-columns:145px minmax(0,1fr);gap:18px;align-items:start;padding:14px 22px;border-top:1px solid var(--line)}
      .staff-row>h3{padding-top:5px}
      .staff-people{display:flex;flex-wrap:wrap;gap:9px 22px;align-items:center}
      .staff-person{position:relative;display:inline-flex;align-items:center;gap:8px;min-height:30px;color:#2a2221;font-size:13px}
      .staff-person.no-photo:before{content:"";width:6px;height:6px;flex:0 0 6px;background:var(--gold);transform:rotate(45deg)}
      .staff-person img{width:32px;height:32px;flex:0 0 32px;border-radius:50%;object-fit:cover}
      .staff-person b{font-weight:800}
      @media(max-width:650px){
        .staff-compact{border-left-width:4px}
        .staff-referents{padding:16px}
        .staff-referent-list.is-single{max-width:none}
        .staff-referent{flex-basis:100%;padding:13px 14px}
        .staff-row{grid-template-columns:1fr;gap:8px;padding:13px 16px}
        .staff-row>h3{padding:0}
        .staff-people{gap:8px 18px}
      }
      .team-birthyears{display:inline-flex;align-self:flex-start;width:max-content;margin:0 0 18px;padding:8px 12px;border-radius:999px;background:var(--gold);color:var(--wine);font-size:12px;font-weight:950;line-height:1;letter-spacing:.02em}
      .team-birthyears[hidden]{display:none}
    </style>
  </head>
  <body>
    <Header/>
    <main id="team-profile">
      <section class="page-hero wine"><p class="eyebrow">Fiche équipe</p><h1 id="team-name" aria-live="polite">Chargement…</h1><p id="team-birthyears" class="team-birthyears" hidden></p><p id="team-description"></p></section>
      <section class="profile-layout content">
        <div class="team-visual" aria-busy="true"><img id="team-photo" alt=""></div>
        <div class="profile-stats">
          <div class="profile-stat profile-stat-count">
            <b id="player-count">—</b>
            <span id="player-label">licenciés pratiquants</span>
          </div>
          <div class="profile-stat profile-stat-engagements">
            <span class="profile-stat-label">Engagements</span>
            <div id="team-level" class="engagement-list" aria-live="polite"><span>—</span></div>
          </div>
        </div>
        <div class="staff" id="team-staff" aria-busy="true" aria-live="polite"><p>Encadrement à venir.</p></div>
        <div><p class="eyebrow">Entraînements</p><h2>Les rendez-vous de la semaine</h2><div id="team-training" class="rows"></div></div>
        <div class="team-results"><p class="eyebrow">Calendrier</p><h2>Les prochains rendez-vous</h2><div id="team-upcoming" class="team-match-list match-calendar"></div></div>
        <div class="team-results"><p class="eyebrow">Compétitions</p><h2>Derniers résultats</h2><div id="team-results" class="team-match-list match-calendar"></div><a class="all-results" href="/matchs/">Voir tout le calendrier →</a></div>

        <div class="team-results team-standings-section">
          <p class="eyebrow">Classements FFF</p>
          <h2>Classement des équipes engagées</h2>

          <div
            id="team-standings"
            class="team-standings"
            aria-live="polite"
          >
            <p>Classement en cours de chargement…</p>
          </div>
        </div>
      </section>
    </main>
    <Footer/>
    <script is:inline src="/team-profile.js?v=36"></script>
  </body>
</html>

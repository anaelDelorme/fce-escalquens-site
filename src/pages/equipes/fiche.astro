---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<html lang="fr">
  <head>
    <meta charset="utf-8"><meta name="viewport" content="width=device-width">
    <title>Fiche équipe - FC Escalquens</title>
    <link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/enhancements.css?v=6"><link rel="stylesheet" href="/brand-charter.css"><link rel="stylesheet" href="/match-cards.css?v=8">
    <style>
      .profile-layout .staff{display:grid;grid-template-columns:1fr;gap:18px;align-items:start}.staff-group{overflow:hidden;border:1px solid #e8ddd7;border-radius:20px;background:#fff;box-shadow:0 10px 32px #5510180b}.staff-group.is-referent-group{border-color:#e7c54f;background:linear-gradient(135deg,#fffaf0 0%,#fff 62%)}.staff-group-head{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:15px 18px;border-bottom:1px solid #eee3dc}.staff-group-head>div{display:grid;gap:3px}.staff-group-head span{font-size:12px;font-weight:950;letter-spacing:.1em;text-transform:uppercase;color:var(--wine)}.staff-group-head small{font-size:11px;color:#796a66}.staff-group-head>b{display:grid;place-items:center;min-width:30px;height:30px;padding:0 8px;border-radius:999px;background:#f4ece7;color:var(--wine);font-size:12px}.is-referent-group .staff-group-head>b{background:var(--gold)}.staff-group-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:1px;background:#eee3dc}.staff-card{min-height:104px;padding:20px;background:#fff;display:flex;align-items:center;gap:16px}.is-referent-group .staff-card{background:#fffdf8}.staff-photo{width:68px;height:68px;flex:0 0 68px;border-radius:50%;object-fit:cover;border:3px solid #fff;box-shadow:0 0 0 2px #eadfda}.is-referent-group .staff-photo{box-shadow:0 0 0 2px var(--gold)}.staff-card-copy{min-width:0;display:grid;gap:7px}.staff-card h3{margin:0;font-size:19px;line-height:1.1}.staff-contacts{display:grid;gap:4px}.staff-contacts a{font-size:12px;color:var(--wine);text-decoration:none;overflow-wrap:anywhere}.staff-contacts a:hover{text-decoration:underline}@media(max-width:600px){.staff-group{border-radius:15px}.staff-group-grid{grid-template-columns:1fr}.staff-card{min-height:88px;padding:16px}.staff-photo{width:56px;height:56px;flex-basis:56px}.staff-card h3{font-size:17px}}
      .team-birthyears{display:inline-flex;align-self:flex-start;width:max-content;margin:0 0 18px;padding:8px 12px;border-radius:999px;background:var(--gold);color:var(--wine);font-size:12px;font-weight:950;line-height:1;letter-spacing:.02em}
      .team-birthyears[hidden]{display:none}
    </style>
  </head>
  <body>
    <Header/>
    <main id="team-profile">
      <section class="page-hero wine"><p class="eyebrow">Fiche équipe</p><h1 id="team-name" aria-live="polite">Chargement…</h1><p id="team-birthyears" class="team-birthyears" hidden></p><p id="team-description"></p></section>
      <section class="profile-layout content">
        <div class="team-visual" aria-busy="true"><img id="team-photo" alt=""></div>
        <div class="profile-stats">
          <div class="profile-stat profile-stat-count">
            <b id="player-count">—</b>
            <span id="player-label">licenciés pratiquants</span>
          </div>
          <div class="profile-stat profile-stat-engagements">
            <span class="profile-stat-label">Engagements</span>
            <div id="team-level" class="engagement-list" aria-live="polite"><span>—</span></div>
          </div>
        </div>
        <div class="staff" id="team-staff" aria-busy="true" aria-live="polite"><p>Encadrement à venir.</p></div>
        <div><p class="eyebrow">Entraînements</p><h2>Les rendez-vous de la semaine</h2><div id="team-training" class="rows"></div></div>
        <div class="team-results"><p class="eyebrow">Calendrier</p><h2>Les prochains rendez-vous</h2><div id="team-upcoming" class="team-match-list match-calendar"></div></div>
        <div class="team-results"><p class="eyebrow">Compétitions</p><h2>Derniers résultats</h2><div id="team-results" class="team-match-list match-calendar"></div><a class="all-results" href="/matchs/">Voir tout le calendrier →</a></div>

        <div class="team-results team-standings-section">
          <p class="eyebrow">Classements FFF</p>
          <h2>Classement des équipes engagées</h2>

          <div
            id="team-standings"
            class="team-standings"
            aria-live="polite"
          >
            <p>Classement en cours de chargement…</p>
          </div>
        </div>
      </section>
    </main>
    <Footer/>
    <script is:inline src="/team-profile.js?v=33"></script>
  </body>
</html>

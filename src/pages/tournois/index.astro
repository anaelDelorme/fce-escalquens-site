---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <title>Tournois du club - FC Escalquens</title>
    <meta name="description" content="Retrouvez les tournois du FC Escalquens : dates, équipes, tarifs, inscriptions, affiches et règlements.">
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/enhancements.css?v=6">
    <link rel="stylesheet" href="/brand-charter.css">
    <link rel="stylesheet" href="/contacts-tournaments.css?v=3"><link rel="stylesheet" href="/shop-commerce.css?v=51"><link rel="stylesheet" href="/tournament-checkout.css">
  </head>
  <body>
    <Header/>
    <main>
      <section class="page-hero wine tournament-hero">
        <p class="eyebrow">Temps forts du club</p>
        <h1>Nos tournois.<br>Nos aventures.</h1>
      </section>
      <section class="content tournaments-content">
        <div class="tournaments-intro">
          <div><p class="eyebrow">À vos agendas</p><h2>Les rendez-vous à ne pas manquer.</h2></div>
        </div>
        <p><a href="/tournois/suivi/">Déjà inscrit ? Suivre mon inscription ou payer plus tard →</a></p><div id="tournaments-list" class="tournament-grid" aria-live="polite"><p>Chargement des tournois…</p></div>
      </section>
    </main>
    <Footer/>
    <script is:inline src="/tournaments.js?v=51"></script>
  <script src="../../scripts/tournaments-checkout.js"></script></body>
</html>

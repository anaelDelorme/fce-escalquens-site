---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <title>Tournois du club - FC Escalquens</title>
    <meta name="description" content="Retrouvez les tournois du FC Escalquens : dates, équipes, tarifs, inscriptions, affiches et règlements.">
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/enhancements.css?v=6">
    <link rel="stylesheet" href="/brand-charter.css">
    <link rel="stylesheet" href="/contacts-tournaments.css?v=5213"><link rel="stylesheet" href="/shop-commerce.css?v=51"><link rel="stylesheet" href="/tournament-checkout.css?v=5213">
  </head>
  <body>
    <Header/>
    <main>
      <section class="page-hero wine">
        <p class="eyebrow">Les rendez-vous du club</p>
        <h1>Les tournois<br>du club.</h1>
        <p>Choisissez votre tournoi et inscrivez les équipes de votre club.</p>
      </section>
      <section class="content tournaments-content">
        <div class="tournament-followup">
          <a class="tournament-tracking-link" href="/tournois/suivi/"><strong>Déjà inscrit ?</strong><span>Suivre mon inscription ou régler →</span></a>
        </div>
        <div id="tournaments-list" class="tournament-grid" aria-live="polite"><p>Chargement des tournois…</p></div>
      </section>
    </main>
    <Footer/>
    <script is:inline src="/tournaments.js?v=526"></script>
  <script src="../../scripts/tournaments-checkout.js"></script></body>
</html>

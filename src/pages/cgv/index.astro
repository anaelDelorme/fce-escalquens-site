---
import LegalPage from '../../components/LegalPage.astro';
import { defaultSettings, termsSections } from '../../shop/terms';
import { TERMS_VERSION } from '../../shop/domain';
---
<LegalPage title="Conditions générales de vente" eyebrow="Boutique du club">
  <p>Version {TERMS_VERSION}. Les conditions affichées lors de votre achat sont conservées avec votre commande et envoyées avec votre récapitulatif.</p>
  <p id="terms-status" role="status">Chargement des coordonnées et conditions en vigueur…</p>
  <div id="terms-body">{termsSections(defaultSettings).map(([title,body])=><section><h2>{title}</h2><p style="white-space:pre-line">{body}</p></section>)}</div>
  <p><a href="/confidentialite/">Politique de confidentialité et exercice de vos droits</a> · <a href="/boutique/">Retour à la boutique</a></p>
  <script is:inline type="module">
    import {api} from '/shop-common.js';
    try{const data=await api('/api/shop/config');const node=document.querySelector('#terms-body');node.replaceChildren(...data.terms_sections.map(([title,body])=>{const section=document.createElement('section');const h=document.createElement('h2');h.textContent=title;const p=document.createElement('p');p.textContent=body;p.style.whiteSpace='pre-line';section.append(h,p);return section;}));document.querySelector('#terms-status').textContent='Conditions applicables aux nouvelles commandes. Vous retrouverez celles de votre achat dans son suivi.';}
    catch{document.querySelector('#terms-status').textContent='Les conditions complètes ne peuvent pas être actualisées. Les ventes restent fermées tant que les informations obligatoires ne sont pas configurées. Contactez le club pour obtenir les conditions applicables.';}
  </script>
</LegalPage>

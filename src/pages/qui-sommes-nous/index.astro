---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <title>Qui nous sommes ? — FC Escalquens</title>
    <meta name="description" content="Découvrez l’histoire, les valeurs, le territoire et la direction technique du FC Escalquens.">
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/enhancements.css?v=6">
    <link rel="stylesheet" href="/brand-charter.css">
    <style is:global>
      .about-root{background:#f8f3eb;color:#201719}
      .about-shell{width:min(1180px,calc(100% - 48px));margin:0 auto}
      .about-hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(360px,.95fr);gap:54px;align-items:stretch;padding:72px 0 64px}
      .about-hero-copy{display:flex;flex-direction:column;justify-content:center;padding:30px 0}
      .about-kicker{margin:0 0 16px;color:var(--wine);font-size:11px;font-weight:950;letter-spacing:.14em;text-transform:uppercase}
      .about-hero h1{max-width:780px;margin:0 0 28px;font:clamp(58px,7.2vw,104px)/.84 Impact,Arial Narrow,sans-serif;text-transform:uppercase;color:var(--wine)}
      .about-hero-copy .about-body{max-width:720px;font-size:18px;line-height:1.7}
      .about-media{min-height:420px;overflow:hidden;border-radius:28px 110px 28px 28px;background:var(--wine);box-shadow:0 25px 70px #55101828}
      .about-media>img{width:100%;height:100%;min-height:420px;object-fit:cover}
      .about-visual-fallback{height:100%;min-height:420px;display:grid;place-content:center;gap:18px;padding:42px;text-align:center;background:radial-gradient(circle at 84% 14%,#e1a70d 0 10%,transparent 10.5%),linear-gradient(145deg,#86102d,#3c0718)}
      .about-visual-fallback>img{display:block!important;width:108px!important;height:108px!important;min-height:0!important;margin:0 auto!important;object-fit:contain!important;filter:drop-shadow(0 12px 24px #0005)}
      .about-visual-fallback strong{color:#fff;font:38px/1 Impact,'Arial Narrow',sans-serif;text-transform:uppercase}
      .about-visual-fallback span{color:var(--gold);font-size:11px;font-weight:900;letter-spacing:.16em;text-transform:uppercase}
      .about-chapter{padding:74px 0 26px}
      .about-chapter-inner{display:grid;grid-template-columns:.55fr 1.45fr;gap:50px;padding-bottom:34px;border-bottom:1px solid #d9cdc5}
      .about-chapter h2{margin:0;font:clamp(42px,5vw,72px)/.9 Impact,sans-serif;text-transform:uppercase;color:var(--wine)}
      .about-body{color:#4e4140;line-height:1.7}
      .about-body p{margin:0 0 14px}
      .about-body ul{margin:14px 0 0;padding:0;display:grid;gap:10px;list-style:none}
      .about-body li{position:relative;padding-left:23px}
      .about-body li:before{content:"";position:absolute;left:0;top:.72em;width:9px;height:9px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 4px #f4e5a8}
      .about-timeline{position:relative;display:grid;gap:22px;padding:30px 0 72px}
      .about-timeline:before{content:"";position:absolute;left:24px;top:24px;bottom:68px;width:2px;background:linear-gradient(var(--gold),#d8ccc4)}
      .about-timeline-card{position:relative;margin-left:62px;display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,.54fr);background:#fff;border:1px solid #e5d8d0;border-radius:22px;overflow:hidden;box-shadow:0 12px 34px #5510180b}
      .about-timeline-card:before{content:"";position:absolute;left:-47px;top:31px;width:14px;height:14px;border-radius:50%;background:var(--wine);box-shadow:0 0 0 7px var(--gold)}
      .about-timeline-copy{padding:28px 30px}
      .about-timeline-card h3,.about-feature h3,.about-people h3{margin:5px 0 16px;font-size:clamp(27px,3vw,40px);line-height:1;color:#201719}
      .about-timeline-card .about-card-media{min-height:260px;background:#f1e9e3}
      .about-card-media>img{width:100%;height:100%;min-height:260px;object-fit:cover}
      .about-feature-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;padding:18px 0 76px}
      .about-feature{display:grid;grid-template-rows:auto 1fr;overflow:hidden;background:#fff;border:1px solid #e5d8d0;border-radius:24px;box-shadow:0 12px 34px #5510180b}
      .about-feature-media{height:270px;background:linear-gradient(145deg,#8e1620,#4d0d1d)}
      .about-feature-media>img{width:100%;height:100%;object-fit:cover}
      .about-feature-copy{padding:28px}
      .about-feature:nth-child(even){border-top:5px solid var(--gold)}
      .about-people{margin:4px auto 82px;display:grid;grid-template-columns:minmax(280px,.65fr) minmax(0,1.35fr);overflow:hidden;border-radius:28px;background:var(--wine);color:#fff;box-shadow:0 24px 60px #55101826}
      .about-people-media{min-height:390px;background:#6f1022}
      .about-people-media>img{width:100%;height:100%;min-height:390px;object-fit:cover}
      .about-people-copy{padding:46px}
      .about-people .about-kicker{color:var(--gold)}
      .about-people h3{color:#fff;font-size:clamp(38px,5vw,64px);text-transform:uppercase}
      .about-people .about-body{color:#f4e7e8}
      .about-empty{padding:90px 24px;text-align:center}
      @media(max-width:850px){
        .about-shell{width:min(100% - 32px,1180px)}
        .about-hero{grid-template-columns:1fr;padding-top:44px;gap:26px}
        .about-media{min-height:330px;border-radius:22px 70px 22px 22px}
        .about-media>img,.about-visual-fallback{min-height:330px}
        .about-chapter-inner{grid-template-columns:1fr;gap:18px}
        .about-timeline-card{grid-template-columns:1fr}
        .about-timeline-card .about-card-media{min-height:220px}
        .about-feature-grid{grid-template-columns:1fr}
        .about-people{grid-template-columns:1fr}
        .about-people-media{min-height:280px}
      }
      @media(max-width:560px){
        .about-hero h1{font-size:54px}
        .about-timeline:before{left:10px}
        .about-timeline-card{margin-left:32px}
        .about-timeline-card:before{left:-28px}
        .about-timeline-copy,.about-feature-copy,.about-people-copy{padding:22px}
      }
    </style>
  </head>
  <body>
    <Header/>
    <main id="about-root" class="about-root" aria-busy="true">
      <div class="about-empty">Chargement de l’histoire du club…</div>
    </main>
    <Footer/>
    <script is:inline src="/about.js?v=2"></script>
  </body>
</html>

---
import TournamentLayout from './TournamentLayout.astro';
const {page='registrations'}=Astro.props;
---
<TournamentLayout admin title="Administration des tournois"><nav class="commerce-tabs" aria-label="Gestion des tournois"><a href="/admin-tournois/" aria-current={page==='registrations'?'page':undefined}>Inscriptions et paiements</a><a href="/admin-tournois/parametres/" aria-current={page==='sales'?'page':undefined}>Tarifs et inscriptions</a><a href="/admin-tournois/acces/" aria-current={page==='admins'?'page':undefined}>Responsables</a></nav><p id="tournament-environment" class="commerce-environment"></p><p id="tournament-admin-message" role="status" tabindex="-1">Chargement…</p><section id="tournament-admin" data-page={page}></section><script src="../scripts/admin-tournaments.js"></script></TournamentLayout>

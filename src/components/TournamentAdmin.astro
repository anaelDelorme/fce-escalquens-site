---
import TournamentLayout from './TournamentLayout.astro';
const {page='registrations'}=Astro.props;
---
<TournamentLayout admin title="Administration des tournois"><div class="commerce-workspace-grid"><nav class="commerce-tabs" aria-label="Gestion des tournois"><a href="/admin-tournois/tournois/" aria-current={page==='events'?'page':undefined}>Tournois, tarifs et formulaires</a><a href="/admin-tournois/" aria-current={page==='registrations'?'page':undefined}>Inscriptions et paiements</a><a href="/admin-tournois/acces/" aria-current={page==='admins'?'page':undefined}>Responsables</a></nav><div class="commerce-workspace-main"><div class="commerce-page-intro"><p class="eyebrow">Tournois</p><h1>{page==='events'?'Tournois et inscriptions':page==='admins'?'Responsables':'Inscriptions et paiements'}</h1><p>{page==='events'?'Préparez chaque tournoi, son formulaire et ses modalités de paiement.':page==='admins'?'Gérez les accès à cet espace, indépendamment du site et de la boutique.':'Retrouvez les équipes, validez les inscriptions et suivez les règlements.'}</p></div><p id="tournament-environment" class="commerce-environment"></p><p id="tournament-admin-message" role="status" aria-live="polite" tabindex="-1">Chargement…</p><section id="tournament-admin" data-page={page}></section></div></div><script src="../scripts/admin-tournaments.js"></script></TournamentLayout>

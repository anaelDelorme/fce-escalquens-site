---
const {page='orders'}=Astro.props;
const links=[['orders','Commandes','/admin-boutique/'],['categories','Catégories','/admin-boutique/categories/'],['products','Articles et photos','/admin-boutique/articles/'],['suppliers','Fournisseurs','/admin-boutique/fournisseurs/'],['cover','Couverture et affichage','/admin-boutique/couverture/'],['settings','Paramètres','/admin-boutique/parametres/'],['admins','Accès administrateurs','/admin-boutique/acces/'],['surveys','Satisfaction','/admin-boutique/satisfaction/']];
---
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="referrer" content="no-referrer"><title>Gestion boutique — FC Escalquens</title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/brand-charter.css"><link rel="stylesheet" href="/shop-commerce.css?v=5"></head><body><main class="commerce-admin" data-page={page}><header class="commerce-admin-head"><div class="commerce-admin-brand"><img src="/logo-fce.webp" alt=""><div><p class="eyebrow">Espace réservé au club</p><h1>Gestion de la boutique.</h1></div></div><div><a href="/boutique/">Voir la boutique</a> · <a href="/cdn-cgi/access/logout">Déconnexion</a></div></header><div id="shop-environment"></div><nav class="commerce-tabs" aria-label="Gestion boutique">{links.map(([id,label,href])=><a href={href} aria-current={id===page?'page':undefined}>{label}</a>)}</nav><p id="admin-shop-message" role="status" aria-live="polite" tabindex="-1">Chargement de la gestion boutique…</p><noscript>Activez JavaScript pour gérer la boutique.</noscript><section id="admin-shop-content" class="commerce-admin-content"></section></main><script src="../scripts/admin-shop.js"></script></body></html>

---
const {page='orders'}=Astro.props;
const links=[['orders','Commandes','/admin-boutique/'],['categories','Catégories','/admin-boutique/categories/'],['products','Articles et photos','/admin-boutique/articles/'],['suppliers','Fournisseurs','/admin-boutique/fournisseurs/'],['cover','Couverture et affichage','/admin-boutique/couverture/'],['settings','Paramètres','/admin-boutique/parametres/'],['admins','Accès administrateurs','/admin-boutique/acces/'],['surveys','Satisfaction','/admin-boutique/satisfaction/']];
const titles={orders:['Commandes','Retrouvez une commande, suivez son paiement et préparez sa remise.'],categories:['Catégories','Organisez les articles pour aider chacun à trouver son équipement.'],products:['Articles et photos','Une fiche par article, avec ses visuels, ses tailles et ses personnalisations.'],suppliers:['Fournisseurs','Retrouvez les partenaires et leurs coordonnées de commande.'],cover:['Présentation de la boutique','Choisissez la couverture et gérez la visibilité de la boutique.'],settings:['Paramètres','Vérifiez les paiements, les e-mails et les informations du club.'],admins:['Accès administrateurs','Gérez les personnes autorisées à administrer la boutique.'],surveys:['Satisfaction','Écoutez les retours pour améliorer le parcours de commande.']};
const [title,description]=titles[page]||titles.orders;
---
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="referrer" content="no-referrer"><title>{title} · Gestion boutique — FC Escalquens</title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/brand-charter.css"><link rel="stylesheet" href="/shop-commerce.css?v=5"><link rel="stylesheet" href="/commerce-ux.css?v=5214"></head><body class="commerce-admin-body"><a class="commerce-skip" href="#admin-shop-content">Aller au contenu</a><main class="commerce-admin commerce-workspace" data-page={page}><header class="commerce-admin-head"><a class="commerce-admin-brand" href="/admin-boutique/"><img src="/logo-fce.webp" alt="FC Escalquens"><div><p class="eyebrow">Espace du club</p><strong>Gestion boutique</strong></div></a><div class="commerce-head-links"><a href="/boutique/">Voir la boutique ↗</a><a href="/cdn-cgi/access/logout">Déconnexion</a></div></header><div id="shop-environment"></div><div class="commerce-workspace-grid"><nav class="commerce-tabs" aria-label="Gestion boutique">{links.map(([id,label,href])=><a href={href} aria-current={id===page?'page':undefined}>{label}</a>)}</nav><div class="commerce-workspace-main"><div class="commerce-page-intro"><p class="eyebrow">Boutique</p><h1>{title}</h1><p>{description}</p></div><p id="admin-shop-message" role="status" aria-live="polite" tabindex="-1">Chargement de la gestion boutique…</p><noscript>Activez JavaScript pour gérer la boutique.</noscript><section id="admin-shop-content" class="commerce-admin-content" aria-label={title}></section></div></div></main><script src="../scripts/admin-shop.js"></script></body></html>

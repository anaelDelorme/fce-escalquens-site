---
import Header from './Header.astro';
import Footer from './Footer.astro';
const {title='Mon inscription',admin=false}=Astro.props;
---
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="referrer" content="no-referrer"><title>{title} — FC Escalquens</title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/brand-charter.css"><link rel="stylesheet" href="/shop-commerce.css?v=51"><link rel="stylesheet" href="/tournament-checkout.css?v=5213"><link rel="stylesheet" href="/commerce-ux.css?v=5213"></head><body class={admin?'commerce-admin-body':undefined}>{admin&&<a class="commerce-skip" href="#tournament-admin">Aller au contenu</a>}{!admin&&<Header/>}<main class={admin?'commerce-admin commerce-workspace':'commerce-layout'}><header class="commerce-admin-head"><div class="commerce-admin-brand">{admin&&<img src="/logo-fce.webp" alt="FC Escalquens"/>}<div><p class="eyebrow">FC Escalquens · Tournois</p>{admin?<strong>Gestion des tournois</strong>:<h1>{title}</h1>}</div></div><p><a href="/tournois/">Les tournois</a>{admin&&<> · <a href="/cdn-cgi/access/logout">Déconnexion</a></>}</p></header><slot/></main>{!admin&&<Footer/>}</body></html>
